{
  "id": "enterprise-orchestrator",
  "name": "Enterprise Conversational Orchestrator",
  "version": "1.0.0",
  "start_node_id": "input",
  "nodes": [
    {"id": "input", "type": "InputNode", "name": "Capture user turn", "config": {}},
    {"id": "intent_router", "type": "RouterNode", "name": "Route by intent", "config": {"routes": {"incident": "incident_agent", "support": "support_agent", "developer": "developer_agent", "workflow": "workflow_agent", "unknown": "clarify"}}},
    {"id": "clarify", "type": "LLMNode", "name": "Clarification prompt", "config": {"mode": "clarify", "required_slots": ["intent"]}},
    {"id": "collect_slot", "type": "ValidationNode", "name": "Validate slots", "config": {"required_slots": ["intent"]}},
    {"id": "support_agent", "type": "AgentNode", "name": "Customer support specialist", "config": {"agent": "support"}},
    {"id": "incident_agent", "type": "AgentNode", "name": "Incident coordinator", "config": {"agent": "incident"}},
    {"id": "developer_agent", "type": "AgentNode", "name": "Developer assistant", "config": {"agent": "developer"}},
    {"id": "workflow_agent", "type": "WorkflowNode", "name": "Workflow automation", "config": {"workflow": "account_unlock"}},
    {"id": "incident_lookup", "type": "ToolNode", "name": "Lookup incident", "config": {"tool": "incident_lookup_tool", "input_mapping": {"incident_id": "incident_id"}}},
    {"id": "graph_query", "type": "ToolNode", "name": "Graph query", "config": {"tool": "graph_query_tool", "input_mapping": {"query": "latest_input"}}},
    {"id": "search", "type": "ToolNode", "name": "Search knowledge", "config": {"tool": "search_tool", "input_mapping": {"query": "latest_input"}}},
    {"id": "user_profile", "type": "ToolNode", "name": "Load user profile", "config": {"tool": "user_profile_tool", "input_mapping": {"user_id": "user_id"}}},
    {"id": "memory_write", "type": "MemoryNode", "name": "Write useful memory", "config": {"operation": "write", "keys": ["intent", "incident_id", "account_id"]}},
    {"id": "decision", "type": "DecisionNode", "name": "Escalation decision", "config": {"rules": [{"condition": "confidence < 0.55", "target": "fallback"}, {"condition": "needs_human == true", "target": "human_approval"}, {"condition": "default", "target": "summary"}]}},
    {"id": "human_approval", "type": "HumanApprovalNode", "name": "Human approval", "config": {"approval_key": "approved"}},
    {"id": "retry_tool", "type": "RetryNode", "name": "Retry failed tool", "config": {"target_node_id": "search", "max_retries": 2}},
    {"id": "fallback", "type": "FallbackNode", "name": "Fallback response", "config": {"message": "I need a bit more detail or a human handoff to continue safely."}},
    {"id": "summary", "type": "LLMNode", "name": "Summarize result", "config": {"mode": "summary"}},
    {"id": "end", "type": "EndNode", "name": "End conversation", "config": {}}
  ],
  "edges": [
    {"id": "input_to_router", "source": "input", "target": "intent_router", "condition": "always"},
    {"id": "router_to_clarify", "source": "intent_router", "target": "clarify", "condition": "route == 'unknown'"},
    {"id": "clarify_to_collect", "source": "clarify", "target": "collect_slot", "condition": "always"},
    {"id": "collect_to_router", "source": "collect_slot", "target": "intent_router", "condition": "slots_complete == true"},
    {"id": "collect_to_end", "source": "collect_slot", "target": "end", "condition": "awaiting_input == true"},
    {"id": "router_to_support", "source": "intent_router", "target": "support_agent", "condition": "route == 'support'"},
    {"id": "router_to_incident", "source": "intent_router", "target": "incident_agent", "condition": "route == 'incident'"},
    {"id": "router_to_developer", "source": "intent_router", "target": "developer_agent", "condition": "route == 'developer'"},
    {"id": "router_to_workflow", "source": "intent_router", "target": "workflow_agent", "condition": "route == 'workflow'"},
    {"id": "support_to_profile", "source": "support_agent", "target": "user_profile", "condition": "intent == 'support'"},
    {"id": "incident_to_lookup", "source": "incident_agent", "target": "incident_lookup", "condition": "incident_id != null"},
    {"id": "incident_to_graph", "source": "incident_agent", "target": "graph_query", "condition": "incident_id == null"},
    {"id": "developer_to_search", "source": "developer_agent", "target": "search", "condition": "always"},
    {"id": "workflow_to_profile", "source": "workflow_agent", "target": "user_profile", "condition": "always"},
    {"id": "tool_to_retry", "source": "search", "target": "retry_tool", "condition": "tool_failed == true"},
    {"id": "lookup_to_memory", "source": "incident_lookup", "target": "memory_write", "condition": "always"},
    {"id": "graph_to_memory", "source": "graph_query", "target": "memory_write", "condition": "always"},
    {"id": "search_to_memory", "source": "search", "target": "memory_write", "condition": "tool_failed != true"},
    {"id": "profile_to_memory", "source": "user_profile", "target": "memory_write", "condition": "always"},
    {"id": "retry_to_search", "source": "retry_tool", "target": "search", "condition": "retry_allowed == true"},
    {"id": "retry_to_fallback", "source": "retry_tool", "target": "fallback", "condition": "retry_allowed == false"},
    {"id": "memory_to_decision", "source": "memory_write", "target": "decision", "condition": "always"},
    {"id": "decision_to_human", "source": "decision", "target": "human_approval", "condition": "needs_human == true"},
    {"id": "decision_to_fallback", "source": "decision", "target": "fallback", "condition": "confidence < 0.55"},
    {"id": "decision_to_summary", "source": "decision", "target": "summary", "condition": "default"},
    {"id": "human_to_end", "source": "human_approval", "target": "end", "condition": "always"},
    {"id": "fallback_to_end", "source": "fallback", "target": "end", "condition": "always"},
    {"id": "summary_to_end", "source": "summary", "target": "end", "condition": "always"}
  ],
  "metadata": {
    "domain": "enterprise-support",
    "patterns": ["intent-routing", "clarification-loop", "tool-use", "retry", "human-handoff", "resume"]
  }
}
