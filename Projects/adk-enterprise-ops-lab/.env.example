# Runtime
OPS_LAB_MODEL=gemini-2.5-flash
OPS_LAB_ENV=local
OPS_LAB_DEBUG=true
OPS_LAB_ARTIFACT_DIR=.artifacts
OPS_LAB_TRACE_DIR=.traces
OPS_LAB_SESSION_DIR=.sessions
OPS_LAB_MEMORY_DIR=.memory

# Google ADK / Vertex placeholders
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_RAG_CORPUS=
VERTEX_SEARCH_DATASTORE=
VERTEX_MEMORY_BANK=
GCS_ARTIFACT_BUCKET=

# MCP placeholders
MCP_TRANSPORT=local
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m enterprise_ops_lab.mcp.mock_mcp_server
MCP_TIMEOUT_MS=1200

# API
API_HOST=127.0.0.1
API_PORT=8000

